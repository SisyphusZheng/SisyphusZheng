    "@lessjs/adapter-vite/plugin-mdx": "jsr:@lessjs/adapter-vite@^0.28.5/plugin-mdx",
    "@lessjs/adapter-vite/subpath-resolver": "jsr:@lessjs/adapter-vite@^0.28.5/subpath-resolver",
    "@lessjs/app": "jsr:@lessjs/app@^0.28.5",
    "@lessjs/cem": "jsr:@lessjs/cem@^0.28.5",
