    "@lessjs/ui/less-step-card": "jsr:@lessjs/ui@^0.28.5/less-step-card",
    "@lessjs/ui/less-theme-toggle": "jsr:@lessjs/ui@^0.28.5/less-theme-toggle",
    "@lessjs/ui/open-props-tokens": "jsr:@lessjs/ui@^0.28.5/open-props-tokens",
    "@site/generated/projects": "./app/data/_generated-project-data.ts"
  },
  "nodeModulesDir": "auto",
  "tasks": {
    "generate:data": "deno run --config deno.json --allow-read --allow-write scripts/generate-data.ts",
    "build": "deno run -A --config deno.json scripts/build.ts",
    "dev": "deno run --config deno.json --allow-read --allow-write --allow-run --allow-env --allow-net scripts/dev.ts",
    "preview": "deno run --config deno.json --allow-read --allow-net scripts/preview.ts"
  },
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "@lessjs/core",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve"
  }
}
