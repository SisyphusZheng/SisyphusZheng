    "@lessjs/ui/less-callout": "jsr:@lessjs/ui@^0.28.5/less-callout",
    "@lessjs/ui/less-card": "jsr:@lessjs/ui@^0.28.5/less-card",
    "@lessjs/ui/less-code-block": "jsr:@lessjs/ui@^0.28.5/less-code-block",
    "@lessjs/ui/less-dialog": "jsr:@lessjs/ui@^0.28.5/less-dialog",
    "@lessjs/ui/less-hero-ping": "jsr:@lessjs/ui@^0.28.5/less-hero-ping",
    "@lessjs/ui/less-input": "jsr:@lessjs/ui@^0.28.5/less-input",
