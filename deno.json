    "@lessjs/core/logger": "jsr:@lessjs/core@^0.28.5/logger",
    "@lessjs/core/render-serialize": "jsr:@lessjs/core@^0.28.5/render-serialize",
    "@lessjs/core/types": "jsr:@lessjs/core@^0.28.5/types",
