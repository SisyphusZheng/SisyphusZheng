{
  "imports": {
    "@hono/vite-dev-server": "npm:@hono/vite-dev-server@^0.25.3",
    "@openelement/element": "npm:@openelement/element@1.0.0-alpha.4",
    "@openelement/element/jsx-dev-runtime": "npm:@openelement/element@1.0.0-alpha.4/jsx-dev-runtime",
    "@openelement/element/jsx-runtime": "npm:@openelement/element@1.0.0-alpha.4/jsx-runtime",
    "@openelement/router": "npm:@openelement/router@1.0.0-alpha.4",
    "@openelement/router/vite": "npm:@openelement/router@1.0.0-alpha.4/vite",
    "gray-matter": "npm:gray-matter@^4.0.3",
    "hono": "npm:hono@^4.12",
    "marked": "npm:marked@^15",
    "vite": "npm:vite@8.0.10",
    "@site/generated/blog-data": "./app/data/_generated-blog-data.ts",
    "@site/generated/projects": "./app/data/_generated-project-data.ts"
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": 0,
  "tasks": {
    "generate:data": "deno run -A --config deno.json scripts/generate-data.ts",
    "check": "deno task generate:data && deno check --config deno.json app/ vite.config.ts openelement.config.ts scripts/",
    "build:vite": "deno run --config deno.json --allow-read --allow-write --allow-net --allow-env --allow-ffi --allow-sys --allow-run npm:@openelement/router@1.0.0-alpha.4/cli/build",
    "build": "deno task generate:data && deno task build:vite",
    "verify": "deno run -A scripts/verify-dist.ts",
    "dev": "deno task generate:data && deno run --config deno.json --allow-read --allow-write --allow-env --allow-net --allow-run --allow-sys --allow-ffi npm:vite@8.0.10",
    "preview": "deno run --config deno.json --allow-read --allow-net scripts/preview.ts"
  },
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "@openelement/element",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true
  },
  "fmt": {
    "exclude": [
      "dist/",
      "node_modules/",
      ".mimosa/",
      ".v2c/",
      ".openElement/",
      ".vite/"
    ],
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve"
  }
}
